{
  "name": "presentation-frame-timer",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir",
    "desktop:win": "electron-builder --win nsis portable",
    "test:electron": "node tests/electron.mjs",
    "desktop:install": "node node_modules/electron/install.js",
    "test:pip": "node tests/pip-browser.mjs",
    "test:audio:web": "node tests/audio-browser.mjs",
    "test:audio:electron": "node tests/audio-electron.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "lab.kkodama.presentation-frame-timer",
    "productName": "Presentation Frame Timer",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "core.js",
      "gauge.js",
      "frame-geometry.js",
      "audio-engine.js",
      "audio/**/*",
      "package.json",
      "time-display.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Presentation-Frame-Timer-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "artifactName": "Presentation-Frame-Timer-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Presentation-Frame-Timer-Portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "kkodamalab",
      "repo": "presentation-frame-timer"
    },
    "extraFiles": [
      {
        "from": "audio/ATTRIBUTION.md",
        "to": "AUDIO-CREDITS.md"
      }
    ]
  },
  "description": "A continuous perimeter timer with a transparent Windows desktop overlay",
  "author": "kkodamalab",
  "engines": {
    "node": ">=22.12.0"
  }
}
